# Supabase client configuration (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional server-side AI keys (never expose these through VITE_ variables)
GEMINI_API_KEY=your_gemini_api_key_server_side_only
OPENAI_API_KEY=your_openai_api_key_server_side_only

# Optional maps configuration
VITE_MAPBOX_TOKEN=your_optional_mapbox_token
